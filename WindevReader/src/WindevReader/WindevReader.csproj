<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>WindevReader</PackageId>
    <Version>0.1.0</Version>
    <Description>Independent read-only readers for WINDEV PCS project, window, procedure, analysis and report files.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup><None Include="../../README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
