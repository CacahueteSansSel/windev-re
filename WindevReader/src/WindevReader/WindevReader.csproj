<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>WindevReader</PackageId>
    <Version>0.5.0</Version>
    <Description>Independent read-only WINDEV readers, BMP window previews, compiled WDL archives and HFSQL descriptors and explicit-layout clear FIC records.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup><None Include="../../README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
